params {
    input_reads = null
    single_end = false
    outdir = "results"
    samplesheet = "samplesheet.csv"
    multiqc_config = null
    fasta       = null
    gtf         = null
    max_cpus = 16
    max_memory = '64.GB'
    max_time = '72.h'
    g = "gene_name"
    strandedness = 0
    enrichr_database = "GO_Biological_Process_2023,KEGG_2026,Reactome_2022"
    deseq2_pvalue = 0.05
    deseq2_logfc  = 1.5
    splicing_read_length = 100
    immucell_ref = 'both'  // 'tumor', 'blood', 'both'

    skip_deconvolution = false
    skip_splicing = false
    skip_fusions = false
    skip_differential = false
}

cleanup = true

docker {
    enabled = true
    autoMounts = true
}

profiles {
    test { includeConfig 'conf/test.config' }
}

process {
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 2
    
    withLabel: 'process_high' {
        cpus   = { Math.min( 20 * task.attempt, params.max_cpus as int ) }
        memory = { 
            def mem = 50.GB * task.attempt
            if (mem.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return mem
        }

        time   = { 
            def time_req = 24.h * task.attempt
            def max_time = params.max_time as nextflow.util.Duration
            if (time_req.compareTo(max_time) == 1)
                return max_time
            else
                return time_req
        }
    }
    
    withLabel: 'process_low' {
        cpus   = 2
        memory = '4.GB'
        time   = '6.h' 
    }

}
